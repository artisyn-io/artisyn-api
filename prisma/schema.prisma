// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// Enum for user roles
enum UserRole {
  USER
  CURATOR
  ADMIN
}

// Enum for curator DataExportRequest status
enum DataExportRequestStatus {
  pending
  processing
  ready
  expired
  failed
  cancelled
}

// Enum for curator verification status
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// Enum for artisan type
enum ArtisanType {
  PERSON
  BUSINESS
}

// User model for both regular users and curators
model User {
  id                            String    @id @default(uuid())
  email                         String    @unique
  password                      String
  walletAddress                 String?   @unique
  firstName                     String
  lastName                      String
  role                          UserRole  @default(USER)
  avatar                        String?
  bio                           String?
  phone                         String?
  googleId                      String?   @db.VarChar(255)
  facebookId                    String?   @db.VarChar(255)
  emailVerifiedAt               DateTime?
  emailVerificationCode         String?   @db.VarChar(128)
  emailVerificationExpiresAt    DateTime?
  emailVerificationAttemptCount Int       @default(0)
  emailVerificationConsumedAt   DateTime?
  emailVerificationRevokedAt    DateTime?
  emailVerificationResendAt     DateTime?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
  deletionRequestedAt           DateTime?
  deletionScheduledAt           DateTime?
  twoFactorEnabled              Boolean   @default(false)
  twoFactorSecret               String?   @db.Text // AES-256-GCM encrypted TOTP secret
  twoFactorConfirmedAt          DateTime?
  twoFactorLastStep             Int? // Last accepted TOTP time step (replay protection)
  dataExportRequests           DataExportRequest[]   @relation("DataExportRequests")
  pendingDeletion              PendingDeletion?       // ← ADD THIS
  applications         Application[]         @relation("Applications")

  // Relations
  curator              Curator?
  artisans             Artisan[]
  reviews              Review[]              @relation("ReviewAuthor")
  receivedReviews      Review[]              @relation("ReviewTarget")
  reviewReports        ReviewReport[]        @relation("ReportReporter")
  sentTips             Tip[]                 @relation("TipSender")
  receivedTips         Tip[]                 @relation("TipReceiver")
  location             Location?             @relation(fields: [locationId], references: [id])
  personalAccessTokens PersonalAccessToken[] @relation("TokenUser")
  media                Media[]
  profile              UserProfile?
  preferences          UserPreferences?
  privacySettings      PrivacySettings?
  linkedAccounts       AccountLink[]         @relation("LinkedAccounts")
  auditLogs            AuditLog[]            @relation("UserAuditLogs")
  jobs                 Job[]
  // Friendship relations
  friendRequests       Friendship[]          @relation("UserFriendRequests")
  receivedRequests     Friendship[]          @relation("FriendOf")
  recoveryCodes        TwoFactorRecoveryCode[]
  jobRequests          JobRequest[]          @relation("ClientJobRequests")
  proposals            Proposal[]            @relation("ArtisanProposals")
  clientEngagements    Engagement[]          @relation("ClientEngagements")
  artisanEngagements   Engagement[]          @relation("ArtisanEngagements")
  supportTickets       SupportTicket[]       @relation("SupportTicketRequester")
  supportMessages      SupportTicketMessage[] @relation("SupportTicketAuthor")
  locationId           String?

  @@index([email])
  @@index([walletAddress])
  @@index([role])
}

// Media model for file storage and management
model Media {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  path         String   @unique
  url          String?
  provider     String   @default("local") // local, s3, cloudinary, etc.
  userId       String?
  tags         String[]
  metadata     Json? // width, height, etc.
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user                        User?                         @relation(fields: [userId], references: [id], onDelete: SetNull)
  verificationApplicationDocs CuratorVerificationDocument[]

  @@index([userId])
  @@index([provider])
  @@map("media")
}

// User personal access token model
model PersonalAccessToken {
  id         String    @id @default(uuid())
  userId     String
  name       String
  token      String    @unique @db.Text
  abilities  Json?
  lastUsedAt DateTime?
  ipAddress  String?
  userAgent  String?   @db.Text
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Relations
  user User @relation("TokenUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("personal_access_token")
}

// User password resets model
model PasswordCodeResets {
  id           String    @id @default(uuid())
  email        String?
  phone        String?
  code         String    @db.VarChar(128)
  expiresAt    DateTime?
  attemptCount Int       @default(0)
  consumedAt   DateTime?
  revokedAt    DateTime?
  purpose      String?   @default("password_reset")
  ipAddress    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@map("password_code_resets")
}

model PendingDeletion {
  id          String   @id @default(cuid())
  userId      String   @unique
  scheduledAt DateTime
  token       String   @unique @default(uuid())
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pending_deletions")
}


// Curator profile model
model Curator {
  id                 String             @id @default(uuid())
  userId             String             @unique
  verificationStatus VerificationStatus @default(PENDING)
  specialties        String[]
  experience         Int // Years of experience
  portfolio          String? // URL to portfolio
  certificates       String[] // URLs to certificates
  verifiedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  user                     User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  verificationApplications CuratorVerificationApplication[]
  verificationHistory      CuratorVerificationHistory[]

  @@index([userId])
  @@index([verificationStatus])
}

// Category model
model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subcategories Subcategory[]
  artisans      Artisan[]

  @@index([name])
}

// Subcategory model
model Subcategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  artisans Artisan[]

  @@index([categoryId])
}

// Location model
model Location {
  id          String   @id @default(uuid())
  address     String?
  city        String
  state       String
  country     String
  postalCode  String?
  latitude    Float
  longitude   Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users    User[]
  artisans Artisan[]

  @@index([city])
  @@index([state])
  @@index([country])
  @@index([latitude, longitude])
}

// Artisan model
model Artisan {
  id           String      @id @default(uuid())
  name         String
  email        String?
  phone        String?
  avatar       String?
  type         ArtisanType @default(PERSON)
  description  String
  price        Float?
  priceRange   Json? // { min: number, max: number }
  images       String[]
  curatorId    String
  categoryId   String
  subcategoryId String?
  locationId   String
  isActive     Boolean     @default(true)
  isVerified   Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  curator     Curator     @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory Subcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  location    Location    @relation(fields: [locationId], references: [id], onDelete: Cascade)
  reviews     Review[]
  tips        Tip[]
  listings    Listing[]
  jobRequests JobRequest[]  @relation("ArtisanJobRequests")

  @@index([curatorId])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([locationId])
  @@index([isActive])
  @@index([isVerified])
}

// Review model
model Review {
  id          String       @id @default(uuid())
  rating      Int          // 1-5
  comment     String?      @db.Text
  authorId    String
  targetId    String       // User being reviewed
  artisanId   String?      // Optional specific artisan being reviewed
  status      ReviewStatus @default(PENDING)
  moderatedBy String?
  moderatedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  author    User           @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  target    User           @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Cascade)
  artisan   Artisan?       @relation(fields: [artisanId], references: [id], onDelete: SetNull)
  response  ReviewResponse?
  reports   ReviewReport[]

  @@index([authorId])
  @@index([targetId])
  @@index([artisanId])
  @@index([status])
}

// Review Response model
model ReviewResponse {
  id        String   @id @default(uuid())
  reviewId  String   @unique
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@map("review_responses")
}

// Review Report model
model ReviewReport {
  id         String       @id @default(uuid())
  reviewId   String
  reporterId String
  reason     ReportReason
  details    String?      @db.Text
  status     ReportStatus @default(PENDING)
  resolvedBy String?
  resolvedAt DateTime?
  resolution String?      @db.Text
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  reporter User   @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([reviewId])
  @@index([reporterId])
  @@index([status])
  @@map("review_reports")
}

// Tip model for user/artisan tipping
model Tip {
  id         String     @id @default(uuid())
  amount     Float
  currency   String     @default("USDC")
  message    String?    @db.Text
  status     TipStatus  @default(PENDING)
  senderId   String
  receiverId String
  artisanId  String?
  txHash     String?    @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  // Relations
  sender   User     @relation("TipSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User     @relation("TipReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  artisan  Artisan? @relation(fields: [artisanId], references: [id], onDelete: SetNull)

  @@index([senderId])
  @@index([receiverId])
  @@index([artisanId])
  @@index([status])
  @@map("tips")
}

// Curator Verification Application model
model CuratorVerificationApplication {
  id              String             @id @default(uuid())
  curatorId       String
  status          VerificationStatus @default(PENDING)
  submittedAt     DateTime           @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?            @db.Text
  metadata        Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  curator   Curator                       @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  documents CuratorVerificationDocument[]
  history   CuratorVerificationHistory[]

  @@index([curatorId])
  @@index([status])
  @@map("curator_verification_applications")
}

// Curator Verification Document model
model CuratorVerificationDocument {
  id            String   @id @default(uuid())
  applicationId String
  mediaId       String
  documentType  String
  documentName  String
  createdAt     DateTime @default(now())

  application CuratorVerificationApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  media       Media                          @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([mediaId])
  @@map("curator_verification_documents")
}

// Curator Verification History model
model CuratorVerificationHistory {
  id            String              @id @default(uuid())
  curatorId     String
  applicationId String?
  action        String
  status        VerificationStatus?
  performedBy   String?
  notes         String?             @db.Text
  metadata      Json?
  createdAt     DateTime            @default(now())

  curator     Curator                         @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  application CuratorVerificationApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([curatorId])
  @@index([applicationId])
  @@map("curator_verification_history")
}

// Listing model
model Listing {
  id           String   @id @default(uuid())
  title        String
  description  String   @db.Text
  price        Float
  currency     String   @default("USD")
  artisanId    String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  artisan      Artisan       @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([artisanId])
  @@index([isActive])
}

// Application model
model Application {
  id          String            @id @default(uuid())
  listingId   String
  applicantId String            // User applying
  status      ApplicationStatus @default(PENDING)
  message     String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  applicant User    @relation("Applications", fields: [applicantId], references: [id], onDelete: Cascade)
  job       Job?

  @@index([listingId])
  @@index([applicantId])
  @@index([status])
}

// User Preferences model
model UserPreferences {
  id                    String   @id @default(uuid())
  userId                String   @unique
  theme                 String   @default("light")
  language              String   @default("en")
  emailNotifications    Boolean  @default(true)
  pushNotifications     Boolean  @default(true)
  marketingEmails       Boolean  @default(false)
  twoFactorAuth         Boolean  @default(false)
  profileVisibility     String   @default("public")
  showEmail             Boolean  @default(false)
  showPhone             Boolean  @default(false)
  activityStatus        String   @default("online")
  readReceipts          Boolean  @default(true)
  analyticsConsent      Boolean  @default(true)
  marketingConsent      Boolean  @default(false)
  thirdPartySharing     Boolean  @default(false)
  cookiePreferences     Json?
  dataSharingPreferences Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_preferences")
}

// User Profile model
model UserProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  title       String?
  company     String?
  website     String?
  location    String?
  socialLinks Json?     // { twitter, github, linkedin, etc. }
  skills      String[]
  interests   String[]
  birthDate   DateTime?
  gender      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_profile")
}

// Privacy Settings model
model PrivacySettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  profileVisibility   String   @default("public")
  showEmail           Boolean  @default(false)
  showPhone           Boolean  @default(false)
  showLocation        Boolean  @default(true)
  allowDirectMessages Boolean  @default(true)
  searchable          Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("privacy_settings")
}

// Account Link model for OAuth / External Accounts
model AccountLink {
  id           String    @id @default(uuid())
  userId       String
  provider     String    // google, github, twitter, etc.
  providerId   String
  email        String?
  displayName  String?
  avatar       String?
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  expiresAt    DateTime?
  isVerified   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation("LinkedAccounts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("account_links")
}

// Audit Log model for security and activity tracking
model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  entityType   String?
  entityId     String?
  ipAddress    String?
  userAgent    String?  @db.Text
  statusCode   Int?
  errorMessage String?  @db.Text
  metadata     Json?
  createdAt    DateTime @default(now())

  user User? @relation("UserAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// Job model for accepted applications
model Job {
  id            String    @id @default(uuid())
  listingId     String
  applicationId String    @unique
  applicantId   String
  status        JobStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listing     Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicant   User        @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([applicantId])
  @@index([status])
  @@map("jobs")
}

// Enum for Job Status
enum JobStatus {
  ACTIVE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  DISPUTED
}

// Friendship model for user connections
model Friendship {
  id          String           @id @default(uuid())
  userId      String
  friendId    String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user        User             @relation("UserFriendRequests", fields: [userId], references: [id], onDelete: Cascade)
  friend      User             @relation("FriendOf", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([userId])
  @@index([friendId])
  @@index([status])
  @@map("friendships")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

// Two-Factor Recovery Codes model
model TwoFactorRecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("two_factor_recovery_codes")
}

// Job Request model
model JobRequest {
  id          String           @id @default(uuid())
  clientId    String
  artisanId   String
  title       String
  description String           @db.Text
  budget      Float?
  status      JobRequestStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  client      User             @relation("ClientJobRequests", fields: [clientId], references: [id], onDelete: Cascade)
  artisan     Artisan          @relation("ArtisanJobRequests", fields: [artisanId], references: [id], onDelete: Cascade)
  proposals   Proposal[]

  @@index([clientId])
  @@index([artisanId])
  @@index([status])
  @@map("job_requests")
}

enum JobRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

// Proposal model
model Proposal {
  id           String         @id @default(uuid())
  jobRequestId String
  artisanId    String
  price        Float
  message      String         @db.Text
  status       ProposalStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  jobRequest   JobRequest     @relation(fields: [jobRequestId], references: [id], onDelete: Cascade)
  artisan      User           @relation("ArtisanProposals", fields: [artisanId], references: [id], onDelete: Cascade)

  @@index([jobRequestId])
  @@index([artisanId])
  @@index([status])
  @@map("proposals")
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
  CANCELLED
}

// Engagement model
model Engagement {
  id         String   @id @default(uuid())
  clientId   String
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  client     User     @relation("ClientEngagements", fields: [clientId], references: [id], onDelete: Cascade)
  artisan    User     @relation("ArtisanEngagements", fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("engagements")
}

// Support Ticket model
model SupportTicket {
  id          String              @id @default(uuid())
  requesterId String
  subject     String
  status      SupportTicketStatus @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  requester   User                @relation("SupportTicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  messages    SupportTicketMessage[]

  @@index([requesterId])
  @@index([status])
  @@map("support_tickets")
}

enum SupportTicketStatus {
  OPEN
  IN_RESP_PENDING
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Support Ticket Message model
model SupportTicketMessage {
  id        String   @id @default(uuid())
  ticketId  String
  authorId  String
  message   String   @db.Text
  createdAt DateTime @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User          @relation("SupportTicketAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([authorId])
  @@map("support_ticket_messages")
}

// Data Export Request model
model DataExportRequest {
  id           String                  @id @default(uuid())
  userId       String
  format       String                  @default("json")
  status       DataExportRequestStatus @default(pending)
  downloadUrl  String?
  fileSize     Int?
  expiresAt    DateTime?
  errorMessage String?                 @db.Text
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  user User @relation("DataExportRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("data_export_request")
}
